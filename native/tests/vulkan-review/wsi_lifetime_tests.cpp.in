static void actualOwnerTransfer() {
 Fixture f;CCVKSwapchain facade;facade._gpuSwapchain=f.swapchain;
 std::weak_ptr<CCVKGPUSwapchain> weak=facade._gpuSwapchain;
 waitResult=VK_TIMEOUT;facade.doDestroy();
 // Remove the fixture's artificial owner; the device queue must be the sole owner.
 auto keep=f.swapchain;f.swapchain=nullptr;keep.reset();CHECK(!weak.expired());
 CHECK(f.gpu.deferredSwapchains.size()==1 && destroyedChains==0);
 waitResult=VK_SUCCESS;CHECK(f.device.retireDeferredSwapchains()==VK_SUCCESS);
 CHECK(weak.expired() && f.gpu.deferredSwapchains.empty() && f.gpu.swapchains.empty() && destroyedChains==1);
 // Fixture cleanup safely treats this detached empty shell as an XR/no-acquire object.
 f.swapchain=Ptr<CCVKGPUSwapchain>{new CCVKGPUSwapchain};f.swapchain->vkSwapchain=VK_NULL_HANDLE;
 std::puts("PASS independent deferred queue is sole strong owner and releases on successful retry.");
}


static void repeatedAcquire() {
    Fixture f;
    waitResult = VK_TIMEOUT;
    f.device.acquire(nullptr, 0);
    CHECK(waits == 1 && releases == 0 && acquireCallbacks == 0 && f.swapchain->abortPending);
    const int attempts = submits;
    waitResult = VK_SUCCESS;
    f.device.acquire(nullptr, 0);
    CHECK(submits == attempts && releases == 1 && gpuSwapchains.empty() && acquireCallbacks == 1);
    std::puts("PASS actual acquire loop exits on failed drain and retries same point");
}
static void presentFenceReuse(bool resetFails) {
    Fixture f;
    CHECK(f.device.abortAcquiredSwapchain(f.swapchain) == VK_SUCCESS);
    f.generation->presentPending[0] = true;
    const int releasesBefore = releases;
    CCVKSwapchain facade; facade._gpuSwapchain = f.swapchain;
    Swapchain *facades[] = {&facade};
    (resetFails ? resetResult : waitResult) = resetFails ? VK_ERROR_OUT_OF_HOST_MEMORY : VK_TIMEOUT;
    f.device.acquire(facades, 1);
    CHECK(f.swapchain->abortPending && f.generation->presentPending[0]);
    CHECK(releases == releasesBefore && gpuSwapchains.size() == 1);
    CHECK(fenceResets == (resetFails ? 1 : 0));
    const int attempts = submits;
    f.queue.submit(nullptr, 0); CHECK(submits == attempts);
    resetResult = waitResult = VK_SUCCESS;
    f.device.acquire(nullptr, 0);
    CHECK(gpuSwapchains.empty() && releases == releasesBefore + 1);
    std::printf("PASS actual acquire present-fence %s failure: no unsafe reset/reuse\n", resetFails ? "reset" : "wait");
}
static void finalShutdownWait() {
    Fixture f; f.generation->presentPending = {true};
    CHECK(f.device.retireSwapchain(f.swapchain, UINT64_MAX) == VK_SUCCESS);
    CHECK(lastWaitTimeout == UINT64_MAX && destroyedChains == 1);
    std::puts("PASS final shutdown explicitly propagates blocking timeout to present fences");
}
static void lostPresentFences() {
    Fixture f; CHECK(f.device.abortAcquiredSwapchain(f.swapchain) == VK_SUCCESS);
    f.generation->presentFences = {handle<VkFence>(), handle<VkFence>(), handle<VkFence>()};
    f.generation->presentPending = {1, 1, 1};
    const int before = waits;
    waitScript = {VK_ERROR_DEVICE_LOST, VK_TIMEOUT};
    CHECK(f.swapchain->surfaceOwner->retireGenerations() == VK_TIMEOUT);
    CHECK(destroyedChains == 0 && f.generation->presentPending == std::vector<uint8_t>({0, 1, 1}));
    waitResult = VK_ERROR_DEVICE_LOST;
    CHECK(f.swapchain->surfaceOwner->retireGenerations() == VK_ERROR_DEVICE_LOST);
    CHECK(waits == before + 4 && destroyedChains == 1);
    std::puts("PASS lost presentation still checks every pending fence before destruction");
}


static void lostSubmitOrder(bool transport, bool idleFails) {
    Fixture f;
    if (transport) f.transport.early = true;
    submitResult = VK_ERROR_DEVICE_LOST;
    idleResult = idleFails ? VK_ERROR_OUT_OF_HOST_MEMORY : VK_ERROR_DEVICE_LOST;
    const VkResult result = f.device.abortAcquiredSwapchain(f.swapchain);
    const auto idle = std::find(driverEvents.begin(), driverEvents.end(), std::string_view("idle"));
    CHECK(idle != driverEvents.end());
    for (auto it = driverEvents.begin(); it != idle; ++it) {
        CHECK(std::string_view(*it) != "destroy-fence" && std::string_view(*it) != "destroy-semaphore");
    }
    CHECK(f.queue.gpuQueue()->completionTracker->completedValue() == 0);
    if (idleFails) {
        CHECK(result == VK_ERROR_OUT_OF_HOST_MEMORY && f.swapchain->abortPending);
        CHECK(destroyedFences == 0 && destroyedSemaphores == 0 && releases == 0);
        if (transport) CHECK(f.gpu.lostSubmissionSemaphores.size() == 1);
        else CHECK(f.swapchain->abortFence != VK_NULL_HANDLE);
        idleResult = VK_ERROR_DEVICE_LOST;
        CHECK(f.device.abortAcquiredSwapchain(f.swapchain) == VK_ERROR_DEVICE_LOST);
        CHECK(f.gpu.lostSubmissionSemaphores.empty() && !f.swapchain->abortFence);
    } else {
        CHECK(result == VK_ERROR_DEVICE_LOST && !f.swapchain->abortPending);
    }
    std::printf("PASS lost %s submit cleanup waits for idle proof%s\n", transport ? "transport" : "drain", idleFails ? "; failed idle retains owners" : "");
}

int main() {
    for (VkResult result : {VK_TIMEOUT, VK_ERROR_OUT_OF_HOST_MEMORY, VK_ERROR_OUT_OF_DEVICE_MEMORY}) abortFailure(result, false);
    for (VkResult result : {VK_ERROR_OUT_OF_HOST_MEMORY, VK_ERROR_OUT_OF_DEVICE_MEMORY}) abortFailure(result, true);
    for (VkResult result : {VK_TIMEOUT, VK_ERROR_OUT_OF_HOST_MEMORY}) generationFailure(result, false);
    generationFailure(VK_ERROR_OUT_OF_HOST_MEMORY, true);
    detachedDestroy(); surfaceDestroy(); releaseFailure(); transportFailure(); replacementFailure();
    lostDevice(false); lostDevice(true);
    timelineRetry(); partialGenerationRetry(); twoWindows(); actualOwnerTransfer();
    repeatedAcquire(); presentFenceReuse(false); presentFenceReuse(true); finalShutdownWait(); lostPresentFences();
    for (bool transport : {false, true}) for (bool idleFails : {false, true}) lostSubmitOrder(transport, idleFails);
    std::puts("28 production-control-flow failure/recovery scenarios passed (CC_DEBUG=0, NDEBUG).");
}
