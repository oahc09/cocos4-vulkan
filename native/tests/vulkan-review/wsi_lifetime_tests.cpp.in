 second->wsi.setSurfaceAvailable(true);second->wsi.setExtent(10,10);second->wsi.onRecreated(1);CHECK(second->wsi.beginAcquire());CHECK(second->wsi.completeAcquire(VK_SUCCESS,0));
 gpuSwapchains.push_back(second);vkSwapchains.push_back(second->vkSwapchain);vkSwapchainIndices.push_back(0);
